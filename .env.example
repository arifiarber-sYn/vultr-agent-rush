# Vultr Serverless Inference (OpenAI-compatible chat completions).
# Copy to .env and fill in. Leave ANY value empty to stay in explicit
# local-fallback planning mode: the API reports source="local-fallback"
# and the reason, instead of pretending a model answered.
VULTR_INFERENCE_BASE_URL=
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=
